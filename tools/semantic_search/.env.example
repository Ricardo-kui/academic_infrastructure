# Copy this file to .env and fill in your API keys

# ── Semantic Search (Alibaba Cloud Bailian / Qwen3-Embedding) ──────────────
# Use an Alibaba Cloud Bailian API key from the cn-beijing console.
# OPENAI_API_KEY and DASHSCOPE_API_KEY are both supported by the local client.
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# ── Agentic Observer (LLM Provider) ────────────────────────────────────────
# Choose one provider: deepseek (default), kimi, openrouter
# DeepSeek: https://platform.deepseek.com ( cheapest: ¥2/M input, ¥8/M output )
# Kimi: https://platform.moonshot.ai
# OpenRouter: https://openrouter.ai

LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com   # optional, has default
# LLM_MODEL=deepseek-chat                   # optional, has default
